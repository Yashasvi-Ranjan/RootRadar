# Copy to .env (git-ignored). scripts/*.sh load it automatically. Every value below is the built-in default,
# so the project also runs with no .env at all. Dev-only credentials: change them for anything but a local machine.

# --- PostgreSQL (backend AND demo payment-service; docker-compose.yml uses DB_USER / DB_PASSWORD too) ---
DB_URL=jdbc:postgresql://localhost:5432/apifd
DB_USER=apifd
DB_PASSWORD=apifd_dev
# Backend integration tests only (mvn test): separate database, never the demo one
TEST_DB_URL=jdbc:postgresql://localhost:5432/apifd_test
TEST_DB_USER=apifd
TEST_DB_PASSWORD=apifd_dev

# --- Backend (port 8080) ---
# `demo` = seed the 4 demo nodes + 3 edges and label the UI as demo. Use an empty/other value for a blank, non-demo system.
SPRING_PROFILES_ACTIVE=demo
# The only browser origin allowed by CORS on /api/**
FRONTEND_ORIGIN=http://localhost:5173
# SSRF allowlist for monitored URLs (exact host match, comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Demo services (gateway 8081, order 8082, payment 8083; bind 127.0.0.1 only) ---
# Token required in the X-Admin-Token header of /admin/** (fault injection). Blank disables the admin API.
DEMO_ADMIN_TOKEN=demo-admin-token
ORDER_SERVICE_URL=http://127.0.0.1:8082
PAYMENT_SERVICE_URL=http://127.0.0.1:8083

# --- Frontend (Vite, port 5173) ---
# Backend origin used by the dev proxy (/api -> here) and by production builds
VITE_API_BASE_URL=http://localhost:8080
